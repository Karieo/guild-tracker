# Copy to .env and fill in. Never commit .env.

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public URL of the site (the Cloudflare subdomain). Must match the Discord redirect.
BASE_URL=https://guild.example.com

# Discord application (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Right-click the server icon > Copy Server ID (turn on Developer Mode in Discord)
DISCORD_GUILD_ID=
# Your own Discord user ID (right-click yourself > Copy User ID). Always the owner.
OWNER_DISCORD_ID=

# Channel webhook for polls/announcements. Can also be set in Admin.
DISCORD_WEBHOOK_URL=
